---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.vue';
import Hero from '../components/Hero.vue';
import TrustedBy from '../components/TrustedBy.vue';
import Features from '../components/Features.vue';
import HowItWorks from '../components/HowItWorks.vue';
import SocialProof from '../components/SocialProof.vue';
import Pricing from '../components/Pricing.vue';
import FinalCTA from '../components/FinalCTA.vue';
import Footer from '../components/Footer.vue';
---

<Layout title="Taskflow - Outil de gestion de tâches pour équipes">
  <Header client:load />
  <main>
    <Hero client:load />
    <TrustedBy client:visible />
    <Features client:visible />
    <HowItWorks client:visible />
    <SocialProof client:visible />
    <Pricing client:visible />
    <FinalCTA client:visible />
  </main>
  <Footer client:visible />
</Layout>

<script>
  // GSAP ScrollTrigger animations
  if (typeof window !== 'undefined' && window.gsap) {
    gsap.registerPlugin(ScrollTrigger);

    // Section headers reveal animation
    const sectionHeaders = document.querySelectorAll('.section-header');
    sectionHeaders.forEach((header) => {
      gsap.fromTo(header, 
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.7,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: header,
            start: 'top 85%',
            once: true
          }
        }
      );
    });

    // Trusted by logos animation
    gsap.fromTo('.trusted-logo',
      { opacity: 0, y: 20 },
      {
        opacity: 0.4,
        y: 0,
        duration: 0.5,
        stagger: 0.08,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: '#trusted',
          start: 'top 85%',
          once: true
        }
      }
    );

    // Feature cards scroll scale effect
    const featureCards = document.querySelectorAll('.feature-card');
    featureCards.forEach((card, index) => {
      // Entrance animation
      gsap.fromTo(card,
        { scale: 0.9, opacity: 0, y: 50 },
        {
          scale: 1,
          opacity: 1,
          y: 0,
          duration: 0.6,
          delay: index * 0.1,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: card,
            start: 'top 85%',
            end: 'top 50%',
            scrub: 1
          }
        }
      );
      
      // Scale down on scroll out
      gsap.to(card, {
        scale: 0.95,
        opacity: 0.7,
        scrollTrigger: {
          trigger: card,
          start: 'bottom 20%',
          end: 'bottom 0%',
          scrub: 1
        }
      });
      
      // Hover effect
      card.addEventListener('mouseenter', () => {
        gsap.to(card, { y: -8, duration: 0.3, ease: 'power2.out' });
      });
      card.addEventListener('mouseleave', () => {
        gsap.to(card, { y: 0, duration: 0.3, ease: 'power2.out' });
      });
    });

    // How it works steps scroll scale effect
    const stepCards = document.querySelectorAll('.step-card');
    stepCards.forEach((card, index) => {
      gsap.fromTo(card,
        { scale: 0.85, opacity: 0, y: 50 },
        {
          scale: 1,
          opacity: 1,
          y: 0,
          duration: 0.7,
          delay: index * 0.1,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: card,
            start: 'top 85%',
            end: 'top 50%',
            scrub: 1
          }
        }
      );
      
      // Scale down on scroll out
      gsap.to(card, {
        scale: 0.92,
        opacity: 0.7,
        scrollTrigger: {
          trigger: card,
          start: 'bottom 20%',
          end: 'bottom 0%',
          scrub: 1
        }
      });
    });

    // Step numbers count up animation
    const stepNumbers = document.querySelectorAll('.step-number');
    stepNumbers.forEach((num, index) => {
      gsap.fromTo(num,
        { scale: 0.5, opacity: 0 },
        {
          scale: 1,
          opacity: 1,
          duration: 0.5,
          delay: index * 0.15,
          ease: 'back.out(1.7)',
          scrollTrigger: {
            trigger: '#how-it-works',
            start: 'top 70%',
            once: true
          }
        }
      );
    });

    // Stats counter animation with easing
    const statNumbers = document.querySelectorAll('.stat-number');
    statNumbers.forEach((stat, index) => {
      const target = parseFloat(stat.getAttribute('data-value') || '0');
      const suffix = stat.getAttribute('data-suffix') || '';
      const isDecimal = target % 1 !== 0;
      
      gsap.fromTo(stat,
        { innerText: 0, opacity: 0, y: 20 },
        {
          innerText: target,
          opacity: 1,
          y: 0,
          duration: 1.5,
          delay: index * 0.1,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: '#social-proof',
            start: 'top 70%',
            once: true
          },
          onUpdate: function() {
            const current = parseFloat(stat.textContent || '0');
            if (isDecimal) {
              stat.textContent = current.toFixed(1) + suffix;
            } else {
              stat.textContent = Math.round(current) + suffix;
            }
          }
        }
      );
    });

    // Testimonials scroll scale effect
    const testimonialCards = document.querySelectorAll('.testimonial-card');
    testimonialCards.forEach((card, index) => {
      gsap.fromTo(card,
        { scale: 0.85, opacity: 0, y: 60 },
        {
          scale: 1,
          opacity: 1,
          y: 0,
          duration: 0.7,
          delay: index * 0.12,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: card,
            start: 'top 90%',
            end: 'top 50%',
            scrub: 1
          }
        }
      );
      
      // Scale down on scroll out
      gsap.to(card, {
        scale: 0.95,
        opacity: 0.8,
        scrollTrigger: {
          trigger: card,
          start: 'bottom 20%',
          end: 'bottom 0%',
          scrub: 1
        }
      });
    });

    // Pricing cards scroll scale effect
    const pricingCards = document.querySelectorAll('.pricing-card');
    pricingCards.forEach((card, index) => {
      gsap.fromTo(card,
        { scale: 0.8, opacity: 0, y: 80 },
        {
          scale: 1,
          opacity: 1,
          y: 0,
          duration: 0.8,
          delay: index * 0.1,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: card,
            start: 'top 90%',
            end: 'top 50%',
            scrub: 1
          }
        }
      );
      
      // Scale down on scroll out
      gsap.to(card, {
        scale: 0.95,
        opacity: 0.8,
        scrollTrigger: {
          trigger: card,
          start: 'bottom 20%',
          end: 'bottom 0%',
          scrub: 1
        }
      });
    });

    // Popular pricing card pulse effect
    const popularCard = document.querySelector('.pricing-card[data-popular="true"]');
    if (popularCard) {
      gsap.to(popularCard, {
        boxShadow: '0 20px 60px -15px rgba(212, 100, 78, 0.3)',
        duration: 1.5,
        repeat: -1,
        yoyo: true,
        ease: 'sine.inOut'
      });
    }

    // Hero screenshot scale on scroll
    gsap.fromTo('.hero-screenshot',
      { scale: 0.85, opacity: 0.5, y: 100 },
      {
        scale: 1,
        opacity: 1,
        y: 0,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#hero',
          start: 'top 80%',
          end: 'center center',
          scrub: 1
        }
      }
    );

    // Hero screenshot parallax after scaling
    gsap.to('.hero-screenshot', {
      y: -80,
      ease: 'none',
      scrollTrigger: {
        trigger: '#hero',
        start: 'center center',
        end: 'bottom top',
        scrub: 1
      }
    });

    // Footer reveal animation
    gsap.fromTo('footer',
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: 'footer',
          start: 'top 90%',
          once: true
        }
      }
    );

    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          gsap.to(window, {
            duration: 1,
            scrollTo: { y: target, offsetY: 80 },
            ease: 'power3.inOut'
          });
        }
      });
    });
  }
</script>
